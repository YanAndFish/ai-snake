+import { describe, expect, it } from "vitest";
+import { buildBatchRequest, decodeBatchAnswers, ExpiredBatchError, matchesBatchState, predictChosenEnd } from "../../src/ai/batch";
+import { DecisionsTransport, type DecisionRequest } from "../../src/ai/client";
+import { AiController } from "../../src/ai/controller";
+import { parseAiResponse } from "../../src/ai/response";
+import { GameSession } from "../../src/app/session";
+import { KeyStore } from "../../src/app/keyStore";
+import { advanceMove, cloneState, createGame, setFood, setSnake, startGame } from "../../src/sim/game";
+
+/** 创建正前方没有食物的局面，使等待期间可连续直行。 */
+function board() {
+  return setFood(startGame(createGame({ seed: 83 }), 83), { x: 0, y: 0 });
+}
+
+/** 为每个独立问题返回同一个带步数的选项。 */
+function answers(request: ReturnType<typeof buildBatchRequest>, choice = "U2") {
+  return { answers: request.questions.map((question) => ({ type: "choice", name: question.name, choice })) };
+}
+
+/** 创建可控制响应到达时机的真实传输层。 */
+function harness() {
+  const calls: { body: { questions: { name: string }[] }; answer: (choice?: string) => void; signal: AbortSignal }[] = [];
+  const transport = new DecisionsTransport(async (_input, init) => new Promise<Response>((resolve) => {
+    const body = JSON.parse(String(init?.body));
+    calls.push({ body, signal: init?.signal as AbortSignal,
+      answer: (choice = "U2") => resolve(new Response(JSON.stringify({ answers: body.questions.map((question: { name: string }) => ({ type: "choice", name: question.name, choice })) }), { status: 200 })) });
+  }));
+  const controller = new AiController(transport);
+  const game = new GameSession({ controller, keyStore: new KeyStore(), batchMode: true });
+  game.setCredentials("sk-test-batch-secret");
+  return { game, controller, calls };
+}
+
+describe("AI 多结果与持续步数", () => {
+  it("不同等待位置分别提问，选项包含危险操作和 KEEP", () => {
+    const state = board();
+    const batch = buildBatchRequest(state, 500, () => state);
+    expect(batch.questions).toHaveLength(9);
+    expect(batch.states.map((item) => item.moveCount)).toEqual([0, 1, 2, 3, 4, 5, 6, 7, 8]);
+    expect(batch.questions[0].choices).toHaveLength(24);
+    expect(batch.questions[0].choices.some((item) => item.value === "KEEP6")).toBe(true);
+    expect(batch.questions[8].choices.find((item) => item.value === "KEEP6")?.description).toContain("COLLISION");
+    expect(batch.questions[0].choices.some((item) => item.value.startsWith("L"))).toBe(false);
+  });
+
+  it("响应按问题名称匹配，采用实际到达位置的答案", () => {
+    const state = board();
+    let current = state;
+    const batch = buildBatchRequest(state, 500, () => current);
+    current = advanceMove(advanceMove(state).state).state;
+    const payload = answers(batch);
+    payload.answers[2].choice = "D3";
+    payload.answers.reverse();
+    const result = decodeBatchAnswers(payload, batch);
+    expect(result).toMatchObject({ action: "down", steps: 3, batchTrace: { selectedMoveCount: 2 } });
+    expect(parseAiResponse(JSON.stringify(result), "right", true).moves).toEqual(["down", "down", "down"]);
+  });
+
+  it("相同坐标但不同蛇身的局面不会采用回答", () => {
+    const state = board();
+    const changed = { ...cloneState(state), snake: [state.snake[0], { x: 9, y: 10 }, { x: 8, y: 10 }] };
+    expect(matchesBatchState(state, changed)).toBe(false);
+    const batch = buildBatchRequest(state, 500, () => changed);
+    expect(() => decodeBatchAnswers(answers(batch), batch)).toThrow(ExpiredBatchError);
+  });
+
+  it("吃到当前食物之后的未知局面不会发给模型", () => {
+    const state = setFood(board(), { x: 11, y: 9 });
+    const batch = buildBatchRequest(state, 500, () => state);
+    expect(batch.states.map((item) => item.snake[0])).toEqual([{ x: 9, y: 9 }, { x: 10, y: 9 }]);
+    const other = { ...state, rng: 123456789, seed: 987654321 };
+    const second = buildBatchRequest(other, 500, () => other);
+    expect(second.input).toBe(batch.input);
+    expect(second.questions).toEqual(batch.questions);
+  });
+
+  it("建立批量问题后实际棋盘保持不变", () => {
+    const state = board();
+    const before = cloneState(state);
+    buildBatchRequest(state, 500, () => state);
+    expect(state).toEqual(before);
+  });
+
+  it.each(["missing", "duplicate", "unknown", "reverse", "refusal"])("拒绝包含 %s 错误的批量响应", (kind) => {
+    const state = board();
+    const batch = buildBatchRequest(state, 500, () => state);
