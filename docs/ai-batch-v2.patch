+import { analyzeMove, type MoveAnalysis } from "../sim/analysis";
+import { advanceMove, enqueueDirection } from "../sim/game";
+import { DIRECTIONS, DX, DY, isOpposite, type Direction, type GameState } from "../sim/types";
+import type { AiAction } from "./types";
+
+/** 一项操作最多持续的移动次数。 */
+export const MAX_BATCH_STEPS = 6;
+/** 一批问题覆盖等待期间最多八次直行后的局面。 */
+export const MAX_BATCH_WAIT_MOVES = 8;
+
+/** Decisions API 中一个带说明的选项。 */
+interface BatchChoice {
+  /** 方向与持续步数，例如 U3、KEEP2。 */
+  value: string;
+  /** 执行该操作时的可观察后果。 */
+  description: string;
+}
+
+/** 等待期间一个确定局面的独立问题。 */
+interface BatchQuestion {
+  /** API 的问题类型。 */
+  type: "choice";
+  /** 包含移动编号的问题名，用于匹配响应。 */
+  name: string;
+  /** 这个局面的坐标、蛇身和决策目标。 */
+  instructions: string;
+  /** 所有非反向操作及其持续步数，包含会碰撞的操作。 */
+  choices: BatchChoice[];
+}
+
+/** 一次批量请求及其适用局面。 */
+export interface BatchRequest {
+  /** 是否允许响应提前到达，等待已选操作执行到起点。 */
+  allowFuture: boolean;
+  /** 各问题共用的游戏规则和时间信息。 */
+  input: string;
+  /** 由请求时可见信息预测的局面；只模拟等待期间直行。 */
+  states: GameState[];
+  /** 每个预测局面对应一个独立问题。 */
+  questions: BatchQuestion[];
+  /** 响应到达时读取实际局面，用于精确匹配适用的问题。 */
+  currentState: () => GameState;
+}
+
+/** 一个已经校验的 API 回答。 */
+export interface BatchAnswer {
+  /** 回答适用的移动编号。 */
+  moveCount: number;
+  /** AI 选择的方向或 KEEP。 */
+  action: AiAction;
+  /** AI 选择的持续步数。 */
+  steps: number;
+}
+
+/** 批量响应的完整回答和实际采用项。 */
+export interface BatchTrace {
+  /** API 返回的全部独立操作。 */
+  answers: BatchAnswer[];
+  /** 响应到达时匹配到的问题编号。 */
+  selectedMoveCount: number;
+}
+
+/** 批量响应覆盖的局面已经全部过去。 */
+export class ExpiredBatchError extends Error {
+  constructor() {
+    super("响应对应的局面已过期，将根据当前局面重新请求");
+    this.name = "ExpiredBatchError";
+  }
+}
+
+const TOKENS: Record<AiAction, string> = { up: "U", down: "D", left: "L", right: "R", keep: "KEEP" };
+const ACTIONS: Record<string, AiAction> = { U: "up", D: "down", L: "left", R: "right", KEEP: "keep" };
+
+/** 比较执行操作需要的可观察状态，不比较 RNG 和墙钟。 */
+export function matchesBatchState(expected: GameState, actual: GameState): boolean {
+  return actual.phase === "playing" && expected.moveCount === actual.moveCount &&
+    expected.width === actual.width && expected.height === actual.height &&
+    expected.direction === actual.direction && expected.eaten === actual.eaten &&
+    expected.moveEveryTicks === actual.moveEveryTicks && actual.queue.length === 0 &&
+    expected.food?.x === actual.food?.x && expected.food?.y === actual.food?.y &&
+    expected.snake.length === actual.snake.length && expected.snake.every((cell, index) =>
+      cell.x === actual.snake[index].x && cell.y === actual.snake[index].y);
+}
+
+/** 描述一段同方向移动，不挑选或修正模型的操作。 */
+function choiceDescription(state: GameState, action: AiAction, steps: number, replyMs: number, analysis: MoveAnalysis): string {
+  const direction = action === "keep" ? state.direction : action;
+  const head = state.snake[0];
+  const food = state.food;
+  const dx = food === null ? 0 : food.x - head.x;
+  const dy = food === null ? 0 : food.y - head.y;
+  const along = dx * DX[direction] + dy * DY[direction];
+  const onLine = food !== null && dx * DY[direction] === dy * DX[direction] && along > 0;
+  const eatAt = onLine && along <= analysis.runway ? along : null;
+  const intervalMs = state.moveEveryTicks * 1000 / 60;
+  const requestAfterMoves = eatAt !== null && eatAt <= steps ? eatAt : 0;
+  const endX = head.x + DX[direction] * steps;
+  const endY = head.y + DY[direction] * steps;
+  const endFood = food === null || (eatAt !== null && eatAt <= steps) ? "unknown after eating" : `dx=${food.x - endX} dy=${food.y - endY}`;
+  return `${action} ${steps} moves: ${steps > analysis.runway ? "COLLISION" : "clear"}; eat=${eatAt !== null && eatAt <= steps}; end_food=${endFood}; remaining_straight=${analysis.runway - steps}; reply_margin=${Math.round((analysis.runway - requestAfterMoves) * intervalMs - replyMs)}ms.`;
+}
+
+/** 为等待期间的各个直行位置建立独立问题，吃食物后停止预测。 */
+export function buildBatchRequest(state: GameState, replyMs: number, currentState: () => GameState, allowFuture = false): BatchRequest {
+  const states: GameState[] = [];
+  let predicted = { ...state, snake: state.snake.map((cell) => ({ ...cell })), queue: [] as Direction[] };
+  for (let offset = 0; offset <= MAX_BATCH_WAIT_MOVES; offset += 1) {
+    states.push(predicted);
+    const next = advanceMove(predicted).state;
+    // 新食物的坐标不可用于决策，也不能用未知食物之后的状态匹配响应。
+    if (next.phase !== "playing" || next.eaten !== predicted.eaten) break;
+    predicted = next;
+  }
+  const input = [
+    "SNAKE/5 CONDITIONAL BATCH",
+    `Start move=${state.moveCount}`,
+    "Each question is independent and gives a complete hypothetical state after waiting straight. Answer that state only. Do not assume any answer from another question.",
+    "When the response arrives, only the answer matching the actual board and move number is used. Other answers are discarded. An early answer waits for the already chosen action to finish. Your action begins at the next movement boundary from its matching state.",
+    `Choose a direction or KEEP together with 1-${MAX_BATCH_STEPS} moves. KEEP maintains that question's heading. The whole action executes at the normal speed, including after eating. The next request starts while your chosen action executes, predicting only the action YOU selected. If the visible apple is eaten, planning waits until its actual replacement is observed. If the next answer is late, the snake holds its last heading.`,
+    `Next response estimate p90=${Math.round(replyMs)}ms; one move=${Math.round(state.moveEveryTicks * 1000 / 60)}ms. Response time is uncertain.`,
+    "Objective: apples give 10 points each; survival is worth 0.5 points per second. Balance progress and survival. Extra safe space alone gives no apple points. Plan the duration to eat or align with visible food while leaving time to respond again.",
+    "All non-reversing directions and durations remain available, including collisions. There is no local rescue, pause, or slowdown. Future food locations are unknown. Coordinates: x right, y down.",
+  ].join("\n");
+  const questions = states.map((snapshot): BatchQuestion => {
+    const head = snapshot.snake[0];
+    const actions: AiAction[] = [...DIRECTIONS.filter((direction) => !isOpposite(direction, snapshot.direction)), "keep"];
+    const choices: BatchChoice[] = [];
+    for (const action of actions) {
+      const analysis = analyzeMove(snapshot, action === "keep" ? snapshot.direction : action);
+      for (let steps = 1; steps <= MAX_BATCH_STEPS; steps += 1) {
+        choices.push({ value: `${TOKENS[action]}${steps}`, description: choiceDescription(snapshot, action, steps, replyMs, analysis) });
+      }
+    }
+    return {
+      type: "choice", name: `move_${snapshot.moveCount}`,
+      instructions: `Choose the action and duration for THIS state: move=${snapshot.moveCount}, board=${snapshot.width}x${snapshot.height}, head=(${head.x},${head.y}), heading=${snapshot.direction}, food=${snapshot.food === null ? "unknown" : `(${snapshot.food.x},${snapshot.food.y})`}, body=${snapshot.snake.map((cell) => `(${cell.x},${cell.y})`).join(" ")}. Maximize the stated objective.`,
+      choices,
+    };
+  });
+  return { input, states, questions, currentState, allowFuture };
+}
+
+/** 校验全部回答后，仅返回与响应到达局面匹配的操作。 */
+export function decodeBatchAnswers(payload: unknown, batch: BatchRequest): { action: AiAction; steps: number; batchTrace: BatchTrace; reason: string } {
+  const raw = typeof payload === "object" && payload !== null ? (payload as { answers?: unknown }).answers : null;
+  if (!Array.isArray(raw) || raw.length !== batch.questions.length) throw new Error("批量响应缺少回答，请重试");
+  const byName = new Map<string, Record<string, unknown>>();
+  for (const answer of raw) {
+    if (typeof answer !== "object" || answer === null || typeof answer.name !== "string" || byName.has(answer.name)) throw new Error("批量响应的问题名称无效或重复");
+    byName.set(answer.name, answer);
+  }
+  const answers = batch.questions.map((question, index): BatchAnswer => {
+    const answer = byName.get(question.name);
+    if (answer?.type !== "choice" || typeof answer.choice !== "string" || !question.choices.some((choice) => choice.value === answer.choice)) throw new Error("批量响应包含无效操作，请重试");
+    const parts = /^(U|D|L|R|KEEP)([1-6])$/.exec(answer.choice)!;
+    return { moveCount: batch.states[index].moveCount, action: ACTIONS[parts[1]], steps: Number(parts[2]) };
+  });
+  const current = batch.currentState();
+  let index = batch.states.findIndex((snapshot) => matchesBatchState(snapshot, current));
+  if (index < 0 && batch.allowFuture && current.moveCount < batch.states[0].moveCount) index = 0;
+  if (index < 0) throw new ExpiredBatchError();
+  const selected = answers[index];
+  return { action: selected.action, steps: selected.steps, batchTrace: { answers, selectedMoveCount: selected.moveCount }, reason: `Decisions API ${TOKENS[selected.action]} for ${selected.steps} moves at move ${selected.moveCount}` };
+}
+
+/** 只预测 AI 已选操作的终点；发生碰撞或出现未知食物时返回 null。 */
+export function predictChosenEnd(state: GameState, moves: readonly Direction[]): GameState | null {
+  let predicted = { ...state, queue: [] as Direction[] };
+  for (const direction of moves) {
+    const beforeEaten = predicted.eaten;
+    predicted = advanceMove(enqueueDirection(predicted, direction)).state;
+    if (predicted.phase !== "playing" || predicted.eaten !== beforeEaten) return null;
+  }
+  return predicted;
+}
